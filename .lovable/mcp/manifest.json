      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List the signed-in user's expenses for a given month (YYYY-MM), optionally filtered by location. Returns up to 500 rows sorted by day.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month_key": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Month in YYYY-MM format, e.g. '2026-07'."
            },
            "location_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional location UUID to filter by."
            }
          },
          "required": [
            "month_key"
          ],
          "additionalProperties": false,
